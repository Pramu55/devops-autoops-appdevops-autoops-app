# Dependencies (installed fresh in Docker build)
node_modules/
**/node_modules/

# Turborepo cache
.turbo/
**/.turbo/

# TypeScript build output (rebuilt in Docker)
**/dist/
*.tsbuildinfo

# Next.js build artifacts
apps/dashboard/.next/
apps/dashboard/out/

# Test files — not needed in production image
apps/*/test/
apps/*/scripts/

# Documentation
docs/
*.md
!apps/api/package.json

# Infrastructure configs — not part of the app image
infra/

# Git metadata
.git/
.gitignore

# CI/CD files
Jenkinsfile

# Editor / OS
.vscode/
.DS_Store
*.swp
