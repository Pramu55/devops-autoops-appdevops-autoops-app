{
  "name": "@autoops/api",
  "version": "1.0.0",
  "private": true,
  "description": "AutoOps API service — Express + TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test --require tsx/cjs test/app.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  }
}
